<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="605.0" prefWidth="666.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.resource_booking.ResourcePageControllerAdmin">
    <children>
        <VBox layoutX="20.0" layoutY="20.0" prefHeight="565.0" prefWidth="626.0" spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>

                <!-- Header Section -->
                <VBox spacing="0.0">
                    <children>
                        <Label styleClass="page-title" text="RESOURCE" />
                        <Label styleClass="page-subtitle" text="Manage and block campus resources" />
                    </children>
                </VBox>

                <!-- Search Bar -->
                <TextField fx:id="searchField" prefHeight="35.0" promptText="Search resources..." styleClass="search-bar" />

                <!-- Dark List Container -->
                <VBox styleClass="resource-list-bg" VBox.vgrow="ALWAYS" spacing="10.0">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="list-header" text="ALL RESOURCES" />
                        </HBox>

                        <!-- Scrollable Area for Resources -->
                        <ScrollPane fitToWidth="true" style="-fx-background: #0A0A0A; -fx-border-color: #0A0A0A;" VBox.vgrow="ALWAYS">
                            <content>
                                <!-- Filled in at runtime by ResourcePageControllerAdmin -->
                                <VBox fx:id="resourceListContainer" spacing="5.0" style="-fx-background-color: #0A0A0A;" />
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>