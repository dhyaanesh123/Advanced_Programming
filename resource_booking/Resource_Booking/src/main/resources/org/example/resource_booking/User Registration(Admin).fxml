<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.TextField?>
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.resource_booking.UserRegistrationController">

   <BorderPane fx:id="listPage">
      <padding>
         <Insets bottom="15" left="15" right="15" top="15" />
      </padding>
      <top>
         <VBox spacing="5">
            <children>
               <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="USER REGISTRATION" />
               <Label style="-fx-text-fill: #7f8c8d;" text="Manage registered student database" />
               <HBox alignment="CENTER_LEFT" style="-fx-padding: 10 0 10 0;">
                  <children>
                     <Label fx:id="studentCountLabel" style="-fx-font-weight: bold;" text="0 registered students" />
                     <Region HBox.hgrow="ALWAYS" />
                     <Button onAction="#onAddStudentClicked" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-background-radius: 5;" text="＋ Add Student" />
                  </children>
               </HBox>
            </children>
         </VBox>
      </top>
      <center>
         <TableView fx:id="userTable">
            <columns>
               <TableColumn fx:id="nameColumn" prefWidth="180.0" text="NAME" />
               <TableColumn fx:id="idColumn" prefWidth="130.0" text="STUDENT ID" />
               <TableColumn fx:id="programmeColumn" prefWidth="220.0" text="PROGRAMME" />
               <TableColumn fx:id="bookingsColumn" prefWidth="110.0" text="BOOKINGS" />
               <TableColumn fx:id="statusColumn" prefWidth="110.0" text="STATUS" />
            </columns>
         </TableView>
      </center>
   </BorderPane>

   <BorderPane fx:id="registerPage" visible="false" managed="false">
      <padding>
         <Insets bottom="15" left="15" right="15" top="15" />
      </padding>
      <center>
         <VBox spacing="10">
            <Label fx:id="messageLabel" />

            <TextField fx:id="fullNameField" promptText="Full Name" />
            <TextField fx:id="studentIdField" promptText="Student ID" />
            <TextField fx:id="programmeField" promptText="Programme" />
            <TextField fx:id="emailField" promptText="Email" />

            <Button text="Register" onAction="#onRegisterClicked" />
            <Button text="Return" onAction="#onReturnClicked" />
         </VBox>
      </center>
   </BorderPane>

</StackPane>