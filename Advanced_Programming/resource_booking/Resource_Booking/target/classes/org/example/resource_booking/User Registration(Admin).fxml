<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.resource_booking.UserRegistrationController">
    <BorderPane fx:id="listPage" style="-fx-background-color: #121212;">
        <padding>
            <Insets bottom="30" left="40" right="40" top="30" />
        </padding>
        <top>
            <VBox spacing="5" BorderPane.alignment="CENTER">
                <Label style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: white;" text="USER REGISTRATION" />
                <Label style="-fx-text-fill: #888888; -fx-font-size: 14px;" text="Manage registered student database" />
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 25 0 15 0;">
                    <Label fx:id="studentCountLabel" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14px;" text="0 registered students" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#onAddStudentClicked" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;" text="＋ Add Student" />
                </HBox>
            </VBox>
        </top>
        <center>
            <TableView fx:id="userTable" style="-fx-background-color: #1E1E1E;">
                <columns>
                    <TableColumn fx:id="nameColumn" prefWidth="200.0" text="NAME" />
                    <TableColumn fx:id="idColumn" prefWidth="120.0" text="STUDENT ID" />
                    <TableColumn fx:id="programmeColumn" prefWidth="220.0" text="PROGRAMME" />
                    <TableColumn fx:id="bookingsColumn" prefWidth="100.0" text="BOOKINGS" />
                    <TableColumn fx:id="statusColumn" prefWidth="100.0" text="STATUS" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </center>
    </BorderPane>

    <BorderPane fx:id="registerPage" visible="false" managed="false" style="-fx-background-color: #121212;">
        <center>
            <VBox alignment="CENTER" maxWidth="450" maxHeight="550" spacing="20" style="-fx-background-color: #1A1A1A; -fx-background-radius: 12; -fx-padding: 40; -fx-border-color: #333333; -fx-border-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 15, 0, 0, 5);">

                <VBox alignment="CENTER" spacing="5">
                    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="Register New Student" />
                    <Label style="-fx-text-fill: #888888; -fx-font-size: 13px;" text="Enter the student's academic details below" />
                </VBox>

                <Label fx:id="messageLabel" alignment="CENTER" wrapText="true" style="-fx-font-size: 13px;" />

                <VBox spacing="15" prefWidth="350">

                    <VBox spacing="6">
                        <Label text="Full Name" style="-fx-text-fill: #CCCCCC; -fx-font-size: 12px; -fx-font-weight: bold;" />
                        <TextField fx:id="fullNameField" promptText="Full Name" style="-fx-padding: 10; -fx-background-color: #2A2A2A; -fx-text-fill: white; -fx-background-radius: 5; -fx-border-color: #444444; -fx-border-radius: 5; -fx-prompt-text-fill: #777777;" />
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Student ID (7 Digits)" style="-fx-text-fill: #CCCCCC; -fx-font-size: 12px; -fx-font-weight: bold;" />
                        <TextField fx:id="studentIdField" promptText="Student ID" style="-fx-padding: 10; -fx-background-color: #2A2A2A; -fx-text-fill: white; -fx-background-radius: 5; -fx-border-color: #444444; -fx-border-radius: 5; -fx-prompt-text-fill: #777777;" />
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Programme" style="-fx-text-fill: #CCCCCC; -fx-font-size: 12px; -fx-font-weight: bold;" />
                        <TextField fx:id="programmeField" promptText="e.g.Software Engineering" style="-fx-padding: 10; -fx-background-color: #2A2A2A; -fx-text-fill: white; -fx-background-radius: 5; -fx-border-color: #444444; -fx-border-radius: 5; -fx-prompt-text-fill: #777777;" />
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Email Address" style="-fx-text-fill: #CCCCCC; -fx-font-size: 12px; -fx-font-weight: bold;" />
                        <TextField fx:id="emailField" promptText="e.g.student@campus.edu" style="-fx-padding: 10; -fx-background-color: #2A2A2A; -fx-text-fill: white; -fx-background-radius: 5; -fx-border-color: #444444; -fx-border-radius: 5; -fx-prompt-text-fill: #777777;" />
                    </VBox>
                </VBox>

                <HBox spacing="15" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                    <Button onAction="#onReturnClicked" prefWidth="130" text="Cancel" style="-fx-background-color: transparent; -fx-text-fill: #CCCCCC; -fx-border-color: #555555; -fx-border-radius: 5; -fx-padding: 10; -fx-cursor: hand; -fx-font-weight: bold;" />
                    <Button onAction="#onRegisterClicked" prefWidth="180" text="Register Student" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10; -fx-cursor: hand;" />
                </HBox>

            </VBox>
        </center>
    </BorderPane>

</StackPane>