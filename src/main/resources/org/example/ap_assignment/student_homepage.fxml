<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ap_assignment.StudentHomeController">
    <left>
        <VBox prefHeight="625.0" prefWidth="180" spacing="15" style="-fx-background-color:white;">
            <padding>
                <Insets bottom="10" left="10" right="10" top="20" />
            </padding>
            <children>
                <ImageView fitHeight="80" fitWidth="80" preserveRatio="true" />
                <Label text="STUDENT">
                    <font>
                        <Font name="System Bold" size="20" />
                    </font>
                </Label>
                <Label fx:id="homeLabel" text="Home" />
                <Label fx:id="bookingLabel" text="Booking" />
                <Label fx:id="resourcesLabel" text="Resources" />
                <Region VBox.vgrow="ALWAYS" />
                <Separator />
                <Label fx:id="profileLabel" text="👤 ARIEF" />
                <Label fx:id="logoutLabel" text="Logout" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="10">
            <padding>
                <Insets bottom="15" left="15" right="15" top="15" />
            </padding>
            <children>
                <Label text="HOME">
                    <font>
                        <Font name="System Bold" size="28" />
                    </font>
                </Label>
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="WELCOME BACK, ARIEF" />
                <Label style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Year 1 Software Engineering" />
                <HBox spacing="20">
                    <children>
                        <VBox prefHeight="380" prefWidth="350" style="-fx-background-color:black;-fx-background-radius:8;-fx-padding:15;">
                            <children>
                                <Label style="-fx-text-fill:white;-fx-font-size:18;-fx-font-weight:bold;-fx-padding:0 0 10 0;" text="CALENDAR" />
                                <GridPane fx:id="calendarGrid" hgap="5" prefHeight="290" prefWidth="310" vgap="5" />
                            </children>
                        </VBox>
                        <VBox prefHeight="380" prefWidth="420" style="-fx-background-color:black;-fx-background-radius:8;-fx-padding:15;">
                            <children>
                                <Label text="REMINDER" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="18" />
                                    </font>
                                </Label>
                                <VBox fx:id="reminderBox" prefHeight="250" prefWidth="390" spacing="10" />
                                <Button maxWidth="390" onAction="#handleBookResource" prefWidth="390" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 5px; -fx-padding: 10 20 10 20;" text="Book a resource" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <HBox alignment="BOTTOM_RIGHT" style="-fx-background-color: transparent; -fx-padding: 20;">
                    <children>
                        <Button fx:id="chatButton" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 25px; -fx-padding: 12 20 12 20; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 5);" text="💬" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>