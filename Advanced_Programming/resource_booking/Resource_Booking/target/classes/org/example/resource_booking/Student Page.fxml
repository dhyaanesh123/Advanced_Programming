<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="700.0" prefWidth="1200.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.resource_booking.StudentController">
    <children>
        <VBox prefWidth="250.0" style="-fx-background-color: #2C2C2C; -fx-padding: 30 20 30 20;">
            <children>

                <Label text="STUDENT" textFill="WHITE">
                    <font><Font name="System Bold" size="28.0" /></font>
                    <padding><Insets bottom="40.0" /></padding>
                </Label>

                <VBox spacing="20.0">
                    <Label fx:id="home" onMouseClicked="#onHomeClicked" style="-fx-cursor: hand;" text="Home" textFill="#CCCCCC">
                        <font><Font name="System Bold" size="18.0" /></font>
                    </Label>
                    <Label fx:id="booking" onMouseClicked="#onBookingClicked" style="-fx-cursor: hand;" text="Booking" textFill="#CCCCCC">
                        <font><Font name="System Bold" size="18.0" /></font>
                    </Label>
                    <Label fx:id="resource" onMouseClicked="#onResourceClicked" style="-fx-cursor: hand;" text="Resource" textFill="#CCCCCC">
                        <font><Font name="System Bold" size="18.0" /></font>
                    </Label>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <VBox spacing="10.0" style="-fx-border-color: #333333; -fx-border-width: 1 0 0 0; -fx-padding: 20 0 0 0;">
                    <Label fx:id="profileLabel" text="👤 STUDENT" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" />
                    <Label fx:id="logout" onMouseClicked="#onLogOut" style="-fx-cursor: hand;" text=" Logout" textFill="#FF5252">
                        <font><Font name="System Bold" size="14.0" /></font>
                    </Label>
                </VBox>

            </children>
        </VBox>

        <StackPane fx:id="contentArea" style="-fx-background-color: #121212;" HBox.hgrow="ALWAYS" />

    </children>
</HBox>