<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="contentArea" spacing="25.0" style="-fx-background-color: #121212; -fx-padding: 30;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.resource_booking.HomePageControllerStudent">
    <VBox spacing="5.0">
        <Label text="HOME" textFill="WHITE">
            <font><Font name="System Bold" size="28.0" /></font>
        </Label>
        <Label fx:id="welcomeLabel" text="WELCOME BACK, STUDENT" textFill="WHITE">
            <font><Font name="System Bold" size="18.0" /></font>
        </Label>
        <Label fx:id="dateLabel" text="Loading programme..." textFill="#888888">
            <font><Font size="14.0" /></font>
        </Label>
    </VBox>

    <HBox spacing="25.0" VBox.vgrow="ALWAYS">

        <VBox style="-fx-background-color: #1A1A1A; -fx-background-radius: 10; -fx-padding: 20; -fx-border-color: #333333; -fx-border-radius: 10;" HBox.hgrow="ALWAYS" maxWidth="500">
            <Label text="CALENDAR" textFill="WHITE" style="-fx-padding: 0 0 15 0;">
                <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <!-- GridPane for the calendar days -->
            <GridPane fx:id="calendarGrid" alignment="CENTER" hgap="8" vgap="8" VBox.vgrow="ALWAYS" />
        </VBox>

        <VBox spacing="15.0" style="-fx-background-color: #1A1A1A; -fx-background-radius: 10; -fx-padding: 20; -fx-border-color: #333333; -fx-border-radius: 10;" HBox.hgrow="ALWAYS">
            <Label text="REMINDERS" textFill="WHITE">
                <font><Font name="System Bold" size="16.0" /></font>
            </Label>

            <VBox fx:id="blockedResourceBox" spacing="10.0" VBox.vgrow="ALWAYS" />

            <Button maxWidth="Infinity" onAction="#handleBookResource" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 15; -fx-cursor: hand;" text="Book a resource" />
        </VBox>

    </HBox>
</VBox>